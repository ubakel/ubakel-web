# build output
dist/
.output/
# dependencies
node_modules/
# generated types
.astro/
# environment — matches at any depth, incl. klinik-console/.env
.env
.env.*
!.env.example
# logs
npm-debug.log*
# macOS
.DS_Store

# ── Not part of the website ──────────────────────────────────────────────
# Klinik Console is a separate application (own Dockerfile, own deploy, own
# secrets). It lives in this folder only for local convenience and must not
# ship in the marketing site repo.
klinik-console/

# Source video masters. Cloudflare Pages rejects any single asset over
# 25 MiB, so these are hosted externally — see DEMO_VIDEO in
# src/components/pages/InsuranceClaimsBody.astro
*.mp4
*.mov

# Local n8n scratch/scripts kept alongside the site while iterating
_*.js

# Editor / tooling local state
.claude/

# wrangler local state
.wrangler/
