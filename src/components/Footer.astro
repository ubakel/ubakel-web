---
// src/components/Footer.astro
import { site, nav } from '../data/site';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);
const year = new Date().getFullYear();
---

<footer class="bg-raisin text-white/70">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-xs">
        <img src="/logo-full-white.svg" alt="Ubakel" class="h-7 w-auto" />
        <p class="mt-5 text-sm leading-relaxed">{t('footer.tagline')}</p>
      </div>

      <nav>
        <p class="font-mono text-[0.7rem] uppercase tracking-widest text-white/40">{t('footer.nav')}</p>
        <ul class="mt-4 space-y-3 text-sm">
          {nav.map((item) => (
            <li><a href={link(item.href)} class="transition-colors hover:text-white">{t(item.key)}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-widest text-white/40">{t('footer.connect')}</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-white">{site.email}</a></li>
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-white/40">© {year} {site.name}. {t('footer.rights')}</p>
      <a href="#top" class="inline-flex items-center gap-2 text-xs text-white/40 transition-colors hover:text-white">
        {t('footer.top')}
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
      </a>
    </div>
  </div>
</footer>
