---
// src/components/ImpactBand.astro
// The ROI proof band — a dark, high-contrast interruption between the light
// sections so the numbers that justify the spend get their own moment
// instead of living only as small print in the hero.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metrics = [
  {
    value: t('impact.m1.value'), label: t('impact.m1.label'), sub: t('impact.m1.sub'),
    d: 'M3 17l6-6 4 4 8-8M21 7v6h-6',
  },
  {
    value: t('impact.m2.value'), label: t('impact.m2.label'), sub: t('impact.m2.sub'),
    d: 'M13 2L4 14h7l-1 8 10-12h-7l1-8z',
  },
  {
    value: t('impact.m3.value'), label: t('impact.m3.label'), sub: t('impact.m3.sub'),
    d: 'M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    value: t('impact.m4.value'), label: t('impact.m4.label'), sub: t('impact.m4.sub'),
    d: 'M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section class="relative overflow-hidden border-b border-line bg-ink py-20 md:py-28">
  <div class="pointer-events-none absolute inset-0 bp-grid bp-grid-fade opacity-[0.06]"></div>
  <div class="pointer-events-none absolute -top-24 end-[-6%] h-[380px] w-[380px] rounded-full bg-crimson/[8%] blur-[130px]"></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow !text-white/45">{t('impact.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white md:text-[2.6rem] md:leading-[1.1]">
        {t('impact.title')}
      </h2>
      <p class="mt-4 text-lg text-white/55">{t('impact.lead')}</p>
    </div>

    <div class="reveal mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((m) => (
        <div class="crop bg-ink p-7 md:p-8">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-crimson/10 text-crimson">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={m.d}/></svg>
          </span>
          <span class="mt-6 block font-display text-4xl font-bold leading-none text-white">{m.value}</span>
          <span class="mt-3 block text-sm font-semibold text-white/90">{m.label}</span>
          <span class="mt-1.5 block text-xs leading-relaxed text-white/40">{m.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* .crop's registration ticks default to the light-mode line colour; give
     this dark band its own so they stay visible against bg-ink. */
  .crop::before, .crop::after { border-color: rgba(255,255,255,0.16); }
  .crop:hover::before, .crop:hover::after { border-color: var(--color-crimson); }
</style>
