---
// src/components/pages/ProductDetailBody.astro
// Shared content for /products/[slug] and every /[locale]/products/[slug].
import CTABand from '../CTABand.astro';
import PipelineDiagram from '../PipelineDiagram.astro';
import type { Product } from '../../data/products';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../../i18n/utils';

interface Props { product: Product }
const { product: prod } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);

const statusStyle = {
  'Live':         'text-crimson border-crimson/30 bg-crimson/5',
  'Beta':         'text-ink border-line bg-canvas',
  'Early access': 'text-muted border-line bg-canvas',
} as const;

const statusKey = {
  'Live':         'status.live',
  'Beta':         'status.beta',
  'Early access': 'status.earlyAccess',
} as const;

const loc = lang === 'en' ? undefined : prod.i18n?.[lang];
const tagline = loc?.tagline ?? prod.tagline;
const overview = loc?.overview ?? prod.overview;
const features = loc?.features ?? prod.features;
const workflowLabels = loc?.workflow ?? prod.workflow.map((w) => w.label);
const metricLabels = loc?.metrics ?? prod.metrics.map((m) => m.label);
const workflow = prod.workflow.map((w, i) => ({ label: workflowLabels[i], kind: w.kind }));
const metrics = prod.metrics.map((m, i) => ({ value: m.value, label: metricLabels[i] }));
---

<!-- Hero -->
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bp-grid bp-grid-fade opacity-60"></div>
  <div class="relative mx-auto max-w-4xl px-5 py-16 md:py-24 lg:px-8">
    <a href={link('/products')} class="eyebrow inline-flex items-center gap-1.5 hover:text-ink">
      <svg class="h-3.5 w-3.5 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      {t('nav.products')}
    </a>
    <div class="animate-fade-up mt-6 flex items-center gap-3">
      <span class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.62rem] uppercase tracking-widest ${statusStyle[prod.status]}`}>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>{t(statusKey[prod.status])}
      </span>
      <span class="font-mono text-xs uppercase tracking-widest text-muted">{tagline}</span>
    </div>
    <h1 class="animate-fade-up mt-4 font-display text-[clamp(2.2rem,5vw,3.75rem)] font-bold leading-[1.05] tracking-tight text-ink" style="animation-delay:.08s">
      {prod.name}
    </h1>
    <p class="animate-fade-up mt-6 max-w-2xl text-lg leading-relaxed text-muted" style="animation-delay:.16s">{overview}</p>

    <div class="animate-fade-up mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:.24s">
      <a href={link('/#contact')} class="inline-flex items-center justify-center gap-2 rounded-md bg-crimson px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-[#b80324]">
        {t('products.cta.demo')}
        <svg class="h-4 w-4 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Live workflow preview -->
<section class="border-b border-line bg-canvas py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <div class="crop rounded-xl border border-line bg-surface p-6 md:p-10">
      <PipelineDiagram steps={workflow} label={t('products.workflow.label')} />
    </div>
  </div>
</section>

<!-- Features -->
<section class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{t('products.features.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{t('products.features.title')}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      {features.map((f) => (
        <div class="crop bg-surface p-7 md:p-8">
          <h3 class="font-display text-lg font-semibold text-ink">{f.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Metrics -->
<section class="border-b border-line bg-canvas py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3">
      {metrics.map((m) => (
        <div class="bg-surface p-8 text-center md:p-10">
          <p class="font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">{m.value}</p>
          <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-widest text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<CTABand />
