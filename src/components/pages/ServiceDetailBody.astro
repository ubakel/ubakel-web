---
// src/components/pages/ServiceDetailBody.astro
// Shared content for /services/[slug] and every /[locale]/services/[slug].
import CTABand from '../CTABand.astro';
import PipelineDiagram from '../PipelineDiagram.astro';
import type { Service } from '../../data/services';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../../i18n/utils';

interface Props { service: Service }
const { service: svc } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);

const loc = lang === 'en' ? undefined : svc.i18n?.[lang];
const title = loc?.title ?? svc.title;
const overview = loc?.overview ?? svc.overview;
const capabilities = loc?.capabilities ?? svc.capabilities;
const outcomes = loc?.outcomes ?? svc.outcomes;

// Representative pipeline for the service overview.
const steps = [
  { label: t('hero.step.ingest'),  kind: 'source'  as const },
  { label: t('step.process'),      kind: 'process' as const },
  { label: t('hero.step.reason'),  kind: 'ai'      as const },
  { label: t('step.sync'),         kind: 'output'  as const },
];
---

<!-- Hero -->
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bp-grid bp-grid-fade opacity-60"></div>
  <div class="relative mx-auto max-w-4xl px-5 py-16 md:py-24 lg:px-8">
    <a href={link('/services')} class="eyebrow inline-flex items-center gap-1.5 hover:text-ink">
      <svg class="h-3.5 w-3.5 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      {t('nav.services')}
    </a>
    <p class="animate-fade-up mt-6 font-mono text-sm tracking-widest text-crimson">{svc.index}</p>
    <h1 class="animate-fade-up mt-3 font-display text-[clamp(2.2rem,5vw,3.75rem)] font-bold leading-[1.05] tracking-tight text-ink" style="animation-delay:.08s">
      {title}
    </h1>
    <p class="animate-fade-up mt-6 max-w-2xl text-lg leading-relaxed text-muted" style="animation-delay:.16s">
      {overview}
    </p>
  </div>
</section>

<!-- Pipeline preview -->
<section class="border-b border-line bg-canvas py-16 md:py-20">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <div class="crop rounded-xl border border-line bg-surface p-6 md:p-10">
      <PipelineDiagram steps={steps} label={t('services.pipeline.label')} />
    </div>
  </div>
</section>

<!-- Capabilities -->
<section class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{t('services.capabilities.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{t('services.capabilities.title')}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      {capabilities.map((c) => (
        <div class="crop bg-surface p-7 md:p-8">
          <h3 class="font-display text-lg font-semibold text-ink">{c.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Outcomes -->
<section class="border-b border-line bg-canvas py-20 md:py-24">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 lg:grid-cols-[0.7fr_1.3fr] lg:px-8">
    <div class="reveal">
      <p class="eyebrow">{t('services.outcomes.eyebrow')}</p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">{t('services.outcomes.title')}</h2>
    </div>
    <ul class="reveal space-y-px overflow-hidden rounded-xl border border-line bg-line">
      {outcomes.map((o) => (
        <li class="flex items-center gap-4 bg-surface p-5 md:p-6">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-crimson/5 text-crimson">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span class="text-ink">{o}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<CTABand />
