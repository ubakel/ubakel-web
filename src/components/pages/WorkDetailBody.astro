---
// src/components/pages/WorkDetailBody.astro
// Shared content for /work/[slug] and every /[locale]/work/[slug].
import CTABand from '../CTABand.astro';
import PipelineDiagram from '../PipelineDiagram.astro';
import type { CaseStudy } from '../../data/work';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../../i18n/utils';

interface Props { study: CaseStudy }
const { study: cs } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);

const loc = lang === 'en' ? undefined : cs.i18n?.[lang];
const client = loc?.client ?? cs.client;
const sector = loc?.sector ?? cs.sector;
const title = loc?.title ?? cs.title;
const summary = loc?.summary ?? cs.summary;
const problem = loc?.problem ?? cs.problem;
const solution = loc?.solution ?? cs.solution;
const architecture = loc?.architecture ?? cs.architecture;
const metrics = loc?.metrics ?? cs.metrics;

// Turn the architecture stages into a schematic pipeline:
// first = source, last = output, the middle stage = ai, others = process.
const mid = Math.floor(architecture.length / 2);
const steps = architecture.map((label, i) => ({
  label,
  kind: (i === 0 ? 'source' : i === architecture.length - 1 ? 'output' : i === mid ? 'ai' : 'process') as
    'source' | 'process' | 'ai' | 'output',
}));
---

<!-- Hero -->
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bp-grid bp-grid-fade opacity-60"></div>
  <div class="relative mx-auto max-w-4xl px-5 py-16 md:py-24 lg:px-8">
    <a href={link('/work')} class="eyebrow inline-flex items-center gap-1.5 hover:text-ink">
      <svg class="h-3.5 w-3.5 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      {t('nav.work')}
    </a>
    <p class="animate-fade-up mt-6 font-mono text-sm uppercase tracking-widest text-crimson">{sector} · {client}</p>
    <h1 class="animate-fade-up mt-3 font-display text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.06] tracking-tight text-ink" style="animation-delay:.08s">
      {title}
    </h1>
    <p class="animate-fade-up mt-6 max-w-2xl text-lg leading-relaxed text-muted" style="animation-delay:.16s">{summary}</p>
  </div>
</section>

<!-- Metrics band -->
<section class="border-b border-line bg-canvas py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
      {metrics.map((m) => (
        <div class="bg-surface p-7 text-center md:p-9">
          <p class="font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">{m.value}</p>
          <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-widest text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Problem / Solution -->
<section class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line px-0 lg:grid-cols-2">
    <div class="crop bg-surface p-8 md:p-12">
      <p class="eyebrow text-muted">{t('work.problem.eyebrow')}</p>
      <p class="mt-5 text-lg leading-relaxed text-ink">{problem}</p>
    </div>
    <div class="crop bg-surface p-8 md:p-12">
      <p class="eyebrow text-crimson">{t('work.solution.eyebrow')}</p>
      <p class="mt-5 text-lg leading-relaxed text-ink">{solution}</p>
    </div>
  </div>
</section>

<!-- Architecture schematic -->
<section class="border-b border-line bg-canvas py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <div class="reveal mb-8 max-w-2xl">
      <p class="eyebrow">{t('work.architecture.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{t('work.architecture.title')}</h2>
    </div>
    <div class="crop rounded-xl border border-line bg-surface p-6 md:p-10">
      <PipelineDiagram steps={steps} />
    </div>

    <div class="mt-8">
      <p class="eyebrow mb-3">{t('work.stack.label')}</p>
      <div class="flex flex-wrap gap-2">
        {cs.stack.map((tech) => (
          <span class="rounded-md border border-line bg-surface px-3.5 py-1.5 font-mono text-xs text-ink">{tech}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<CTABand />
