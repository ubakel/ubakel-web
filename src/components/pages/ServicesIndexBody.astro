---
// src/components/pages/ServicesIndexBody.astro
// Shared content for /services and every /[locale]/services — the two
// route files just wrap this in Layout/Navbar/Footer so translation and
// markup can't drift between the English and localized versions.
import CTABand from '../CTABand.astro';
import { services } from '../../data/services';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bp-grid bp-grid-fade opacity-60"></div>
  <div class="relative mx-auto max-w-4xl px-5 py-16 text-center md:py-24 lg:px-8">
    <p class="animate-fade-up eyebrow">{t('services.eyebrow')}</p>
    <h1 class="animate-fade-up mt-4 font-display text-[clamp(2.2rem,5vw,4rem)] font-bold leading-[1.05] tracking-tight text-ink" style="animation-delay:.08s">
      {t('services.title')}
    </h1>
    <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg text-muted" style="animation-delay:.16s">
      {t('services.page.lead')}
    </p>
  </div>
</section>

<section class="bg-canvas py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2">
      {services.map((s) => {
        const loc = lang === 'en' ? undefined : s.i18n?.[lang];
        const title = loc?.title ?? s.title;
        const summary = loc?.summary ?? s.summary;
        return (
        <a href={link(`/services/${s.slug}`)} class="group crop relative flex flex-col bg-surface p-7 transition-colors hover:bg-canvas md:p-10">
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs tracking-widest text-muted">{s.index}</span>
            <svg class="h-5 w-5 text-muted transition-all rtl:-scale-x-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 group-hover:text-crimson" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </div>
          <h2 class="mt-6 font-display text-2xl font-semibold text-ink transition-colors group-hover:text-crimson">{title}</h2>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{summary}</p>
        </a>
        );
      })}
    </div>
  </div>
</section>

<CTABand />
