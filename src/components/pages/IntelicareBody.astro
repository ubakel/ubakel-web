---

<!-- Hero -->
<section class="relative overflow-hidden border-b border-line bg-ink">
  <div class="pointer-events-none absolute inset-0 bp-grid opacity-[0.05]"></div>
  <div class="pointer-events-none absolute -top-32 end-[-10%] h-[440px] w-[440px] rounded-full bg-crimson/[14%] blur-[130px]"></div>
  <div class="pointer-events-none absolute bottom-[-12%] start-[-8%] h-[380px] w-[380px] rounded-full bg-burgundy/[16%] blur-[130px]"></div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-14 px-5 py-16 md:py-24 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:px-8">
    <div>
      <a href={link('/products')} class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-white/45 hover:text-white/70">
        <svg class="h-3.5 w-3.5 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        {t('nav.products')}
      </a>

      <p class="animate-fade-up mt-6 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-widest text-white/50" style="animation-delay:.05s">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-crimson opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-crimson"></span>
        </span>
        {c.kicker}
      </p>

      <h1 class="animate-fade-up mt-5 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-bold leading-[1.06] tracking-tight text-white" style="animation-delay:.12s">
        {c.title}
      </h1>

      <p class="animate-fade-up mt-6 max-w-xl text-lg leading-relaxed text-white/60" style="animation-delay:.2s">
        {c.lead}
      </p>

      <div class="animate-fade-up mt-9 flex flex-col gap-3 sm:flex-row" style="animation-delay:.28s">
        <a href={link('/#contact')}
           class="group inline-flex items-center justify-center gap-2 rounded-md bg-crimson px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-[#b80324]">
          {c.ctaPrimary}
          <svg class="h-4 w-4 transition-transform rtl:-scale-x-100 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#demo-chat"
           class="inline-flex items-center justify-center gap-2 rounded-md border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/50">
          {c.ctaSecondary}
        </a>
      </div>
    </div>

    <!-- Phone mockup + system-record confirmation card -->
    <div class="relative mx-auto w-full max-w-[300px] lg:max-w-none" id="demo-chat">
      <div class="ic-phone relative mx-auto w-[280px] rounded-[2.25rem] border-4 border-white/10 bg-raisin p-2.5 shadow-2xl">
        <div class="absolute start-1/2 top-3.5 z-20 h-1.5 w-16 -translate-x-1/2 rounded-full bg-white/15 rtl:translate-x-1/2"></div>
        <div class="relative z-10 flex h-[440px] flex-col overflow-hidden rounded-[1.6rem] bg-[#ECE5DD]">
          <div class="flex items-center gap-2.5 bg-[#075E54] px-3.5 py-3">
            <img src="/logo-mark-white.svg" alt="" class="h-7 w-7 rounded-full bg-white/10 p-1" />
            <div class="min-w-0">
              <div class="truncate text-[0.82rem] font-semibold text-white">Klinik Sejahtera</div>
              <div class="truncate text-[0.66rem] text-white/70">{c.phoneSubtitle}</div>
            </div>
          </div>
          <div id="ic-chat-body" class="flex flex-1 flex-col gap-1.5 overflow-hidden p-3"></div>
        </div>
      </div>

      <!-- System-record card: reveals once the booking confirms, proving this
           writes to a real system rather than just replying in chat. -->
      <div id="ic-confirm-card" class="ic-confirm crop absolute bottom-[-1.5rem] start-[-1rem] w-[240px] rounded-xl border border-line bg-surface p-4 opacity-0 shadow-[0_24px_50px_-20px_rgba(0,0,0,0.55)] sm:w-[260px] lg:bottom-6 lg:start-auto lg:end-[-2.5rem]">
        <div class="flex items-center justify-between border-b border-line-soft pb-2.5">
          <span class="flex items-center gap-1.5 font-mono text-[0.62rem] uppercase tracking-widest text-muted">
            <svg class="h-3.5 w-3.5 text-crimson" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3zm0 0v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>
            {c.confirm.title}
          </span>
          <span class="inline-flex items-center gap-1 rounded-full border border-crimson/30 bg-crimson/5 px-2 py-0.5 font-mono text-[0.58rem] uppercase tracking-widest text-crimson">
            <span class="h-1.5 w-1.5 rounded-full bg-crimson"></span>{c.confirm.status}
          </span>
        </div>
        <dl class="mt-2.5 space-y-1.5 text-[0.72rem]">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-muted">{c.confirm.patientLabel}</dt>
            <dd class="truncate font-medium text-ink">{c.confirm.patient}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-muted">{c.confirm.whenLabel}</dt>
            <dd class="font-medium text-ink">{c.confirm.when}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-muted">{c.confirm.idLabel}</dt>
            <dd class="font-mono text-ink">{c.confirm.id}</dd>
          </div>
        </dl>
        <p class="mt-2.5 flex items-center gap-1.5 border-t border-line-soft pt-2.5 font-mono text-[0.6rem] text-muted">
          <svg class="h-3 w-3 text-crimson" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          {c.confirm.synced}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{c.featuresEyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{c.featuresTitle}</h2>
      <p class="mt-4 text-lg text-muted">{c.featuresLead}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {c.features.map((f) => (
        <div class="crop bg-surface p-7 md:p-8">
          <h3 class="font-display text-lg font-semibold text-ink">{f.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- How it works -->
<section class="border-b border-line bg-canvas py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{c.howEyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{c.howTitle}</h2>
    </div>

    <div class="mt-10 crop rounded-xl border border-line bg-surface p-6 md:p-10">
      <PipelineDiagram steps={pipelineSteps} />
    </div>

    <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {c.how.map((step, i) => (
        <div class="crop bg-surface p-6 md:p-7">
          <span class="font-mono text-xs tracking-widest text-crimson">0{i + 1}</span>
          <h3 class="mt-3 font-display text-base font-semibold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Reliability -->
<section class="relative overflow-hidden border-b border-line bg-ink py-20 md:py-28">
  <div class="pointer-events-none absolute inset-0 bp-grid opacity-[0.06]"></div>
  <div class="pointer-events-none absolute -top-24 end-[-6%] h-[380px] w-[380px] rounded-full bg-crimson/[8%] blur-[130px]"></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow !text-white/45">{c.reliabilityEyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">{c.reliabilityTitle}</h2>
      <p class="mt-4 text-lg text-white/55">{c.reliabilityLead}</p>
    </div>

    <div class="reveal mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-3">
      {c.reliabilityPoints.map((p) => (
        <div class="ic-crop-dark bg-ink p-7 md:p-8">
          <h3 class="font-display text-lg font-semibold text-white">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/50">{p.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-white/10 pt-8">
      <span class="font-mono text-[0.68rem] uppercase tracking-widest text-white/40">{c.runsOn}</span>
      {runsOnIcons.map((icon) => (
        <span class="inline-flex items-center gap-2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill={`#${icon.hex}`}><path d={icon.d}/></svg>
          <span class="font-display text-sm font-semibold text-white/70">{icon.name}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="bg-canvas py-20 md:py-28">
  <div class="reveal mx-auto max-w-3xl px-5 text-center lg:px-8">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{c.ctaTitle}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{c.ctaLead}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={link('/#contact')}
         class="group inline-flex items-center justify-center gap-2 rounded-md bg-crimson px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-[#b80324]">
        {c.ctaPrimary}
        <svg class="h-4 w-4 transition-transform rtl:-scale-x-100 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center justify-center gap-2 rounded-md border border-line bg-surface px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-ink">
        <svg class="h-4 w-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.463 3.488A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
        {c.ctaWhatsapp}
      </a>
    </div>
  </div>
</section>

<script define:vars={{ chat: c.chat, reduceMotion: false }}>
  const body = document.getElementById('ic-chat-body');
  const confirmCard = document.getElementById('ic-confirm-card');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function bubble(msg) {
    const wrap = document.createElement('div');
    const isBot = msg.from === 'bot';
    wrap.className = (isBot ? 'self-start bg-white' : 'self-end bg-[#DCF8C6]') +
      ' max-w-[82%] rounded-lg px-2.5 py-1.5 shadow-sm ic-msg';
    wrap.innerHTML = '<p class="text-[0.72rem] leading-snug text-[#111]">' + msg.text + '</p>';
    return wrap;
  }

  function typingBubble() {
    const wrap = document.createElement('div');
    wrap.className = 'self-start flex items-center gap-1 rounded-lg bg-white px-3 py-2.5 shadow-sm ic-msg';
    wrap.innerHTML = '<span class="ic-dot"></span><span class="ic-dot"></span><span class="ic-dot"></span>';
    return wrap;
  }

  async function playSequence() {
    if (!body) return;
    body.innerHTML = '';
    confirmCard.style.opacity = '0';
    confirmCard.style.transform = '';

    if (prefersReduced) {
      chat.forEach((m) => body.appendChild(bubble(m)));
      confirmCard.style.opacity = '1';
      return;
    }

    for (const msg of chat) {
      const typing = typingBubble();
      body.appendChild(typing);
      body.scrollTop = body.scrollHeight;
      await new Promise((r) => setTimeout(r, msg.from === 'bot' ? 900 : 500));
      typing.remove();

      const el = bubble(msg);
      body.appendChild(el);
      requestAnimationFrame(() => el.classList.add('ic-msg-in'));
      body.scrollTop = body.scrollHeight;
      await new Promise((r) => setTimeout(r, 550));
    }

    confirmCard.style.transition = 'opacity .5s ease, transform .5s ease';
    confirmCard.style.opacity = '1';
    confirmCard.style.transform = 'translateY(0)';

    await new Promise((r) => setTimeout(r, 6000));
    playSequence();
  }

  playSequence();
</script>

<style>
  .ic-msg { opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; }
  .ic-msg-in { opacity: 1; transform: translateY(0); }

  .ic-dot { width: 5px; height: 5px; border-radius: 999px; background: #9aa0a6; animation: icBounce 1.1s infinite; }
  .ic-dot:nth-child(2) { animation-delay: .15s; }
  .ic-dot:nth-child(3) { animation-delay: .3s; }
  @keyframes icBounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }

  #ic-confirm-card { transform: translateY(10px); }

  .ic-crop-dark { position: relative; }
  .ic-crop-dark::before, .ic-crop-dark::after { content: ""; position: absolute; width: 10px; height: 10px; border-style: solid; border-color: rgba(255,255,255,0.16); pointer-events: none; }
  .ic-crop-dark::before { top: 8px; left: 8px; border-width: 1px 0 0 1px; }
  .ic-crop-dark::after { bottom: 8px; right: 8px; border-width: 0 1px 1px 0; }

  @media (prefers-reduced-motion: reduce) {
    .ic-msg { opacity: 1 !important; transform: none !important; }
    #ic-confirm-card { transform: none !important; }
  }
</style>
