<script define:vars={{ timeline: c.timeline }}>
  const list = document.getElementById('cl-timeline-body');
  const toast = document.getElementById('cl-toast');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function row(step) {
    const li = document.createElement('li');
    li.className = 'cl-row flex gap-3 border-b border-white/5 py-3 last:border-b-0';
    const dotColor = step.done ? 'bg-crimson' : 'bg-white/25';
    li.innerHTML =
      '<span class="mt-1 flex h-2 w-2 shrink-0 rounded-full ' + dotColor + '"></span>' +
      '<div class="min-w-0 flex-1">' +
        '<div class="flex items-baseline justify-between gap-3">' +
          '<p class="text-[0.82rem] font-medium text-white">' + step.label + '</p>' +
          '<span class="shrink-0 font-mono text-[0.65rem] text-white/40">' + step.time + '</span>' +
        '</div>' +
        (step.note ? '<p class="mt-0.5 text-[0.72rem] text-white/40">' + step.note + '</p>' : '') +
      '</div>';
    return li;
  }

  async function playSequence() {
    if (!list) return;
    list.innerHTML = '';
    toast.style.opacity = '0';
    toast.style.transform = '';

    if (prefersReduced) {
      timeline.forEach((s) => list.appendChild(row(s)));
      toast.style.opacity = '1';
      return;
    }

    for (const step of timeline) {
      const el = row(step);
      el.style.opacity = '0';
      el.style.transform = 'translateY(6px)';
      el.style.transition = 'opacity .35s ease, transform .35s ease';
      list.appendChild(el);
      requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; });
      await new Promise((r) => setTimeout(r, 900));
    }

    toast.style.transition = 'opacity .5s ease, transform .5s ease';
    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';

    await new Promise((r) => setTimeout(r, 6000));
    playSequence();
  }

  playSequence();

  const playBtn = document.getElementById('cl-video-play');
  const video = document.getElementById('cl-video');
  playBtn?.addEventListener('click', () => {
    playBtn.classList.add('hidden');
    video?.classList.remove('hidden');
    video?.play();
  });
</script>

