const c = COPY[lang];

/**
 * Demo walkthrough video.
 *
 * Left empty on purpose: Cloudflare Pages rejects any single asset over
 * 25 MiB, and the source recording is ~92 MB, so it cannot be committed to
 * this repo and served statically. Host it once (YouTube / Vimeo unlisted,
 * Cloudflare Stream, or an R2 public bucket) and paste the URL here — the
 * section renders a real player automatically and falls back to a
 * "coming soon" panel while this is blank.
 *
 *   kind: 'embed' → iframe (YouTube / Vimeo / Cloudflare Stream embed URL)
 *   kind: 'file'  → <video> tag (direct .mp4 URL, e.g. an R2 public link)
 */
const DEMO_VIDEO: { url: string; kind: 'embed' | 'file' } = {
  url: '',
  kind: 'embed',
};

const pipelineSteps = [
