---
// src/components/WorkPreview.astro
import { caseStudies } from '../data/work';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);

// Bento spans keyed off each case study's size hint.
const span = {
  lg: 'md:col-span-2 md:row-span-2',
  md: 'md:col-span-1 md:row-span-1',
  sm: 'md:col-span-1 md:row-span-1',
} as const;
---

<section id="work" class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">{t('work.eyebrow')}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-[2.6rem] md:leading-[1.1]">
          {t('work.title')}
        </h2>
        <p class="mt-4 text-lg text-muted">{t('work.lead')}</p>
      </div>
      <a href={link('/work')} class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-ink">
        {t('work.all')}
        <svg class="h-4 w-4 transition-transform rtl:-scale-x-100 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="mt-12 grid auto-rows-[minmax(180px,auto)] grid-cols-1 gap-4 md:grid-cols-3">
      {caseStudies.map((c) => {
        const loc = lang === 'en' ? undefined : c.i18n?.[lang];
        const sector = loc?.sector ?? c.sector;
        const title = loc?.title ?? c.title;
        const summary = loc?.summary ?? c.summary;
        const metrics = loc?.metrics ?? c.metrics;
        return (
        <a href={link(`/work/${c.slug}`)}
           class={`group crop relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-surface p-6 transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-24px_rgba(13,13,13,0.35)] md:p-8 ${span[c.size]}`}>
          <div class="flex items-center justify-between">
            <span class="font-mono text-[0.7rem] uppercase tracking-widest text-muted">{sector}</span>
            <svg class="h-5 w-5 text-muted transition-all rtl:-scale-x-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 group-hover:text-crimson" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </div>
          <div>
            <h3 class={`font-display font-semibold text-ink transition-colors group-hover:text-crimson ${c.size === 'lg' ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
              {title}
            </h3>
            {c.size === 'lg' && <p class="mt-3 max-w-md text-muted">{summary}</p>}
            <div class="mt-5 flex flex-wrap gap-2">
              {metrics.slice(0, c.size === 'lg' ? 3 : 2).map((m) => (
                <span class="inline-flex items-baseline gap-1.5 rounded border border-line px-2.5 py-1">
                  <span class="font-display text-sm font-bold text-ink">{m.value}</span>
                  <span class="font-mono text-[0.62rem] uppercase tracking-wider text-muted">{m.label}</span>
                </span>
              ))}
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</section>
