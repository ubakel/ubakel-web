---
// src/components/Contact.astro
import { site } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">

      <!-- Left: pitch + direct channels -->
      <div class="reveal">
        <p class="eyebrow">{t('contact.eyebrow')}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-[2.6rem] md:leading-[1.1]">
          {t('contact.title')}
        </h2>
        <p class="mt-5 max-w-md text-lg text-muted">{t('contact.lead')}</p>

        <div class="mt-9 space-y-3">
          <a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer"
             class="group crop flex items-center gap-4 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-[#25D366]">
            <span class="flex h-11 w-11 items-center justify-center rounded-md bg-canvas text-[#25D366]">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-ink group-hover:text-[#25D366]">{t('contact.whatsapp')}</span>
              <span class="block truncate text-sm text-muted">{site.whatsapp.display}</span>
            </span>
          </a>

          <a href={`mailto:${site.email}`}
             class="group crop flex items-center gap-4 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-crimson">
            <span class="flex h-11 w-11 items-center justify-center rounded-md bg-canvas text-crimson">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-ink group-hover:text-crimson">{t('contact.email')}</span>
              <span class="block truncate text-sm text-muted">{site.email}</span>
            </span>
          </a>

          <div class="flex flex-wrap gap-2 pt-1">
            {site.socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink">
                {s.label}
                <svg class="h-3.5 w-3.5 text-muted rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: form card -->
      <div class="reveal crop rounded-2xl border border-line bg-surface p-6 shadow-[0_20px_50px_-30px_rgba(13,13,13,0.4)] sm:p-9">
        <!-- Success state -->
        <div id="form-success" class="hidden flex-col items-center justify-center py-10 text-center">
          <span class="mb-5 flex h-14 w-14 items-center justify-center rounded-full border border-crimson/30 bg-crimson/5 text-crimson">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          <h3 class="font-display text-2xl font-bold text-ink">{t('contact.ok.title')}</h3>
          <p class="mt-3 max-w-sm text-muted">{t('contact.ok.body')}</p>
          <button id="reset-form-btn" class="mt-6 text-sm font-semibold text-crimson hover:underline">{t('contact.ok.again')}</button>
        </div>

        <!-- Native POST works with zero JS; the script below enhances it. -->
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value="New architecture audit request — Ubakel" />
          <input type="hidden" name="from_name" value="Ubakel Website" />
          <input type="hidden" name="redirect" value="https://web3forms.com/success" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.f.name')}</span>
              <input type="text" name="name" required placeholder="Jane Doe"
                class="w-full rounded-md border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-crimson focus:outline-none focus:ring-2 focus:ring-crimson/20" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.f.email')}</span>
              <input type="email" name="email" required placeholder="jane@company.com"
                class="w-full rounded-md border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-crimson focus:outline-none focus:ring-2 focus:ring-crimson/20" />
            </label>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.f.company')}</span>
              <input type="text" name="company" required placeholder="Acme Corp"
                class="w-full rounded-md border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-crimson focus:outline-none focus:ring-2 focus:ring-crimson/20" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.f.phone')} <span class="font-normal text-muted">{t('contact.f.optional')}</span></span>
              <input type="tel" name="phone" placeholder={site.whatsapp.display}
                class="w-full rounded-md border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-crimson focus:outline-none focus:ring-2 focus:ring-crimson/20" />
            </label>
          </div>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.f.message')}</span>
            <textarea name="message" rows="4" required placeholder={t('contact.f.placeholder')}
              class="w-full resize-none rounded-md border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-crimson focus:outline-none focus:ring-2 focus:ring-crimson/20"></textarea>
          </label>

          <div id="form-error" class="hidden rounded-md border border-crimson/20 bg-crimson/5 px-4 py-3 text-center text-sm text-crimson"></div>

          <button type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-crimson px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-[#b80324]">
            <span id="btn-text">{t('contact.f.submit')}</span>
            <svg class="h-4 w-4 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ sending: t('contact.f.sending'), submit: t('contact.f.submit'), errMsg: t('contact.err') }}>
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('btn-text');
  const ok = document.getElementById('form-success');
  const err = document.getElementById('form-error');
  const reset = document.getElementById('reset-form-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.textContent = sending;
      err.classList.add('hidden');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          form.classList.add('hidden');
          ok.classList.remove('hidden');
          ok.classList.add('flex');
          form.reset();
        } else {
          err.textContent = data.message || errMsg;
          err.classList.remove('hidden');
        }
      } catch {
        err.textContent = errMsg;
        err.classList.remove('hidden');
      } finally {
        btn.textContent = submit;
      }
    });
    reset?.addEventListener('click', () => {
      ok.classList.add('hidden');
      ok.classList.remove('flex');
      form.classList.remove('hidden');
    });
  }
</script>
