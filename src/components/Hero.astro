---
// src/components/Hero.astro
import { getLangFromUrl, useTranslations, localizeAvailable } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);

// The mark's own three pieces (see public/logo-mark.svg) — reused here so the
// hero visual is built out of Ubakel's actual geometry, not a stand-in.
const markPieces = [
  'M636.065 591.595V55.7049L730.686 -2.20537e-06V645.447L519.102 768.911L156.388 557.445V271.112L249.695 215.947V503.593L365.343 570.58L479.677 503.593V146.333L572.984 91.1682V92.4817V557.445L459.964 624.431L519.102 659.895L636.065 591.595Z',
  'M0 363.054L91.9928 307.888V699.298L0 644.133V363.054Z',
  'M457.336 804.375L156.388 628.372V736.075L365.343 858.226L457.336 804.375Z',
];
---

<!-- The hero is the mark's stage, full stop — headline, lead, and CTAs sit
     inside the same dark scene as the assembling logo, instead of a light
     text block sitting above a separate boxed panel. -->
<section class="mark-hero relative overflow-hidden border-b border-line bg-ink">
  <div class="pointer-events-none absolute inset-0 bp-grid opacity-[0.05]"></div>
  <div class="pointer-events-none absolute -top-32 end-[-10%] h-[440px] w-[440px] rounded-full bg-crimson/[14%] blur-[130px]"></div>
  <div class="pointer-events-none absolute bottom-[-12%] start-[-8%] h-[380px] w-[380px] rounded-full bg-burgundy/[16%] blur-[130px]"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-20 pt-16 md:pb-28 md:pt-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow animate-fade-up inline-flex items-center gap-2 !text-white/50" style="animation-delay:.05s">
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-crimson"></span>
        {t('hero.eyebrow')}
      </p>

      <h1 class="animate-fade-up mt-6 font-display text-[clamp(2.4rem,6vw,4.75rem)] font-bold leading-[1.03] tracking-tight text-white" style="animation-delay:.12s">
        {t('hero.title')}
      </h1>

      <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/55" style="animation-delay:.2s">
        {t('hero.lead')}
      </p>

      <div class="animate-fade-up mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay:.28s">
        <a href={link('/#contact')}
           class="group inline-flex w-full items-center justify-center gap-2 rounded-md bg-crimson px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-[#b80324] sm:w-auto">
          {t('hero.primary')}
          <svg class="h-4 w-4 transition-transform rtl:-scale-x-100 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={link('/products')}
           class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/50 sm:w-auto">
          {t('hero.secondary')}
        </a>
      </div>
    </div>

    <!-- The mark: its three real pieces assemble once on load, then it just
         stays there — a slow 3D tilt, an occasional light sweep, and a
         periodic pulse (the same "systems live" heartbeat as the nav status
         dot) keep it feeling alive without inventing an abstract stand-in. -->
    <div class="relative mx-auto mt-16 max-w-4xl md:mt-20">
      <div class="mark-scene relative mx-auto flex justify-center">
        <div class="mark-wrap relative animate-fade-up" style="animation-delay:.4s">
          <svg class="mark-svg w-[clamp(150px,20vw,240px)]" viewBox="-140 -140 1011 1139" role="img" aria-label="Ubakel">
            <circle class="mark-ring" cx="365" cy="430" r="120" fill="none" stroke-width="2"/>
            {markPieces.map((d) => (
              <path class="mark-piece" d={d} fill="#8a2438"/>
            ))}
          </svg>
          <div class="mark-shine pointer-events-none absolute inset-[-20%]" aria-hidden="true"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .mark-scene { perspective: 900px; }
  .mark-wrap {
    transform-style: preserve-3d;
    animation: markFadeIn .8s var(--ease-out-expo) .4s both, markSway 6s ease-in-out 1.8s infinite;
  }
  @keyframes markFadeIn { from { opacity: 0; transform: translateY(22px); } }
  @keyframes markSway {
    0%, 100% { transform: rotateY(-7deg) rotateX(2deg); }
    50%      { transform: rotateY(7deg) rotateX(-1deg); }
  }

  .mark-piece {
    transform-box: fill-box;
    transform-origin: center;
  }
  .mark-svg .mark-piece:nth-child(2) { animation: markFly1 1.1s cubic-bezier(.17,.84,.24,1.28) .4s both; }
  .mark-svg .mark-piece:nth-child(3) { animation: markFly2 1.1s cubic-bezier(.17,.84,.24,1.28) .52s both; }
  .mark-svg .mark-piece:nth-child(4) { animation: markFly3 1.1s cubic-bezier(.17,.84,.24,1.28) .64s both; }
  @keyframes markFly1 { from { transform: translate(-120px,-90px) rotate(-40deg) scale(.6); opacity:0; } 55% { opacity:1; } to { transform:none; opacity:1; } }
  @keyframes markFly2 { from { transform: translate(-90px,60px) rotate(35deg) scale(.6); opacity:0; } 55% { opacity:1; } to { transform:none; opacity:1; } }
  @keyframes markFly3 { from { transform: translate(70px,110px) rotate(-25deg) scale(.6); opacity:0; } 55% { opacity:1; } to { transform:none; opacity:1; } }

  .mark-ring {
    stroke: var(--color-crimson);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: markRingPulse 4.5s ease 1.4s infinite;
  }
  @keyframes markRingPulse {
    0%   { opacity: 0;   transform: scale(.4); }
    10%  { opacity: .9; }
    32%  { opacity: 0;   transform: scale(1.9); }
    100% { opacity: 0;   transform: scale(1.9); }
  }

  .mark-shine {
    background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.55) 50%, transparent 58%);
    mix-blend-mode: screen;
    opacity: 0;
    animation: markShine 5s ease-in-out 2.6s infinite;
  }
  @keyframes markShine {
    0%, 80%, 100% { opacity: 0; transform: translateX(-60%); }
    88%           { opacity: 1; }
    96%           { opacity: 0; transform: translateX(60%); }
  }
  :global(html[dir="rtl"]) .mark-shine { animation-direction: reverse; }


  @media (prefers-reduced-motion: reduce) {
    .mark-svg .mark-piece:nth-child(2),
    .mark-svg .mark-piece:nth-child(3),
    .mark-svg .mark-piece:nth-child(4) { animation: none; opacity: 1; transform: none; }
    .mark-wrap { animation: none; opacity: 1; transform: rotateY(-5deg); }
    .mark-shine, .mark-ring { animation: none; opacity: 0; }
  }
</style>
