---
// src/components/Services.astro
import { services } from '../data/services';
import { getLangFromUrl, useTranslations, localizeAvailable } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (h: string) => localizeAvailable(h, lang);
---

<section id="services" class="border-b border-line bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <!-- Section heading -->
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{t('services.eyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-[2.6rem] md:leading-[1.1]">
        {t('services.title')}
      </h2>
      <p class="mt-4 text-lg text-muted">{t('services.lead')}</p>
    </div>

    <!-- 2×2 grid of hairline-bordered white cards -->
    <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2">
      {services.map((s) => {
        const title = lang === 'en' ? s.title : (s.i18n?.[lang]?.title ?? s.title);
        const summary = lang === 'en' ? s.summary : (s.i18n?.[lang]?.summary ?? s.summary);
        return (
        <a href={link(`/services/${s.slug}`)}
           class="group crop relative flex flex-col bg-surface p-7 transition-colors hover:bg-canvas md:p-9">
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs tracking-widest text-muted">{s.index}</span>
            <svg class="h-5 w-5 text-muted transition-all duration-300 rtl:-scale-x-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 group-hover:text-crimson"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </div>
          <h3 class="mt-6 font-display text-xl font-semibold text-ink transition-colors group-hover:text-crimson md:text-2xl">
            {title}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{summary}</p>
        </a>
        );
      })}
    </div>
  </div>
</section>
