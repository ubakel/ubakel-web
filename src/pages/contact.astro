---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact UBAKEL — Discuss your workflow" description="Tell UBAKEL about the workflow you want to improve. Request an initial audit by email or WhatsApp.">
  <header class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-6 lg:px-8">
    <a href="/" aria-label="UBAKEL home"><img src="/design-review/assets/logo.svg" alt="UBAKEL" width="164" height="48" /></a>
    <a href="/" class="text-sm font-semibold">Back to homepage ↗</a>
  </header>
  <main id="main"><Contact /></main>
  <Footer />
</Layout>
