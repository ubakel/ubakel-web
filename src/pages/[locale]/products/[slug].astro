---
// src/pages/[locale]/products/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ProductDetailBody from '../../../components/pages/ProductDetailBody.astro';
import { products, getProduct } from '../../../data/products';
import { languages, defaultLang } from '../../../i18n/ui';
import { getLangFromUrl } from '../../../i18n/utils';

// Intelicare gets a bespoke landing page (src/pages/[locale]/products/intelicare.astro)
// instead of the generic template — excluded here to avoid a duplicate route.
export function getStaticPaths() {
  const locales = Object.keys(languages).filter((locale) => locale !== defaultLang);
  return locales.flatMap((locale) =>
    products
      .filter((p) => p.slug !== 'intelicare')
      .map((p) => ({ params: { locale, slug: p.slug }, props: { product: p } }))
  );
}

const { product: prod } = Astro.props;
if (!prod) return Astro.redirect('/products');

const lang = getLangFromUrl(Astro.url);
const loc = prod.i18n?.[lang as 'ar' | 'ms'];
const summary = loc?.summary ?? prod.summary;
---

<Layout title={`${prod.name} — Ubakel`} description={summary}>
  <span id="top"></span>
  <Navbar />
  <main id="main">
    <ProductDetailBody product={prod} />
  </main>
  <Footer />
</Layout>
