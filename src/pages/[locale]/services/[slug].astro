---
// src/pages/[locale]/services/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ServiceDetailBody from '../../../components/pages/ServiceDetailBody.astro';
import { services, getService } from '../../../data/services';
import { languages, defaultLang } from '../../../i18n/ui';
import { getLangFromUrl } from '../../../i18n/utils';

export function getStaticPaths() {
  const locales = Object.keys(languages).filter((locale) => locale !== defaultLang);
  return locales.flatMap((locale) =>
    services.map((s) => ({ params: { locale, slug: s.slug }, props: { service: s } }))
  );
}

const { service: svc } = Astro.props;
if (!svc) return Astro.redirect('/services');

const lang = getLangFromUrl(Astro.url);
const loc = svc.i18n?.[lang as 'ar' | 'ms'];
const title = loc?.title ?? svc.title;
const summary = loc?.summary ?? svc.summary;
---

<Layout title={`${title} — Ubakel`} description={summary}>
  <span id="top"></span>
  <Navbar />
  <main id="main">
    <ServiceDetailBody service={svc} />
  </main>
  <Footer />
</Layout>
