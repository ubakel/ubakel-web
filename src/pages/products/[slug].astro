---
// src/pages/products/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductDetailBody from '../../components/pages/ProductDetailBody.astro';
import { products, getProduct } from '../../data/products';

// Intelicare gets a bespoke landing page (src/pages/products/intelicare.astro)
// instead of the generic template — excluded here to avoid a duplicate route.
export function getStaticPaths() {
  return products
    .filter((p) => p.slug !== 'intelicare')
    .map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const prod = product ?? getProduct(Astro.params.slug!);
if (!prod) return Astro.redirect('/products');
---

<Layout title={`${prod.name} — Ubakel`} description={prod.summary}>
  <span id="top"></span>
  <Navbar />
  <main id="main">
    <ProductDetailBody product={prod} />
  </main>
  <Footer />
</Layout>
